<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system's own splash (icon popping in on the app's background) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_icon_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
</resources>
